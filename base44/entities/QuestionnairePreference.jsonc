{
  "name": "QuestionnairePreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "legacy_import",
        "match_questionnaire",
        "plus_activation",
        "plus_edit"
      ]
    },
    "source_match_id": {
      "type": "string"
    },
    "answers": {
      "type": "object",
      "properties": {
        "q_smoking": { "type": "string", "enum": ["a", "b"] },
        "q_partners": { "type": "string", "enum": ["a", "b"] },
        "q_pets": { "type": "string", "enum": ["a", "b"] },
        "q_cleaning_strictness": { "type": "string", "enum": ["a", "b"] },
        "q_shopping": { "type": "string", "enum": ["a", "b"] },
        "q_dishes": { "type": "string", "enum": ["a", "b"] },
        "q_ac": { "type": "string", "enum": ["a", "b"] },
        "q_hosting": { "type": "string", "enum": ["a", "b"] }
      },
      "required": [
        "q_smoking",
        "q_partners",
        "q_pets",
        "q_cleaning_strictness",
        "q_shopping",
        "q_dishes",
        "q_ac",
        "q_hosting"
      ]
    }
  },
  "required": [
    "user_id",
    "version",
    "completed_at",
    "source",
    "answers"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
