{
  "name": "Review",
  "type": "object",
  "properties": {
    "reviewer_id": {
      "type": "string"
    },
    "reviewed_id": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "is_external": {
      "type": "boolean",
      "default": false,
      "description": "True when this review was submitted by someone outside the app via a shared review link, rather than by a logged-in app user."
    }
  },
  "required": [
    "reviewer_id",
    "reviewed_id",
    "rating"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}