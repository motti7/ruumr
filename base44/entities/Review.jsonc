{
  "name": "Review",
  "type": "object",
  "properties": {
    "reviewer_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05db\u05ea\u05d1 \u05d0\u05ea \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea"
    },
    "reviewed_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05e7\u05d9\u05d1\u05dc \u05d0\u05ea \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea"
    },
    "rating": {
      "type": "number",
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05de-1 \u05e2\u05d3 5"
    },
    "text": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d7\u05d5\u05d5\u05ea \u05d4\u05d3\u05e2\u05ea"
    },
    "reviewer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05db\u05d5\u05ea\u05d1"
    }
  },
  "required": [
    "reviewer_id",
    "reviewed_id",
    "rating"
  ],
  "rls": {
    "read": true,
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}