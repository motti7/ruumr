{
  "name": "TypingStatus",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    }
  },
  "required": [
    "match_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}",
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.match_id": {
            "$in": [
              "{{base44.entities.Match.filter({'$or': [{'data.user1_id': '{{user.id}}'}, {'data.user2_id': '{{user.id}}'}]}).id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}",
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}",
      "data.user_id": "{{user.id}}"
    }
  }
}