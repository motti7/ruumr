{
  "name": "ProfileSignalAnswer",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user who answered the profile signal question"
    },
    "profile_id": {
      "type": "string",
      "description": "The user's current Profile record id at answer time"
    },
    "question_id": {
      "type": "string"
    },
    "question_version": {
      "type": "number",
      "default": 1
    },
    "answer_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "onboarding",
        "profile_prompt"
      ],
      "default": "profile_prompt"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ]
    },
    "markers": {
      "type": "object",
      "description": "Derived marker deltas attached to the selected answer"
    },
    "answered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "profile_id",
    "question_id",
    "question_version",
    "answer_id",
    "source",
    "media_type",
    "answered_at"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
