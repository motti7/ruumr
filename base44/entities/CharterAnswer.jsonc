{
  "name": "CharterAnswer",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d4\u05ea\u05d0\u05de\u05d4"
    },
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05e2\u05e0\u05d4"
    },
    "question_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e9\u05d0\u05dc\u05d4"
    },
    "answer": {
      "type": "string",
      "enum": [
        "a",
        "b"
      ],
      "description": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05e9\u05e0\u05d1\u05d7\u05e8\u05d4"
    },
    "accepted_compromise": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e7\u05d9\u05d1\u05dc \u05d0\u05ea \u05d4\u05e4\u05e9\u05e8\u05d4"
    }
  },
  "required": [
    "match_id",
    "user_id",
    "question_id",
    "answer"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}