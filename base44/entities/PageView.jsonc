{
  "name": "PageView",
  "type": "object",
  "properties": {
    "page_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e2\u05de\u05d5\u05d3 \u05e9\u05d1\u05d5\u05e7\u05e8"
    },
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e7\u05e8"
    }
  },
  "required": [
    "page_name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}