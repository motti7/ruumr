{
  "name": "Match",
  "type": "object",
  "properties": {
    "user1_id": {
      "type": "string",
      "description": "מזהה משתמש ראשון"
    },
    "user1_name": {
      "type": "string",
      "description": "שם משתמש ראשון"
    },
    "user2_id": {
      "type": "string",
      "description": "מזהה משתמש שני"
    },
    "user2_name": {
      "type": "string",
      "description": "שם משתמש שני"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked"
      ],
      "default": "active"
    },
    "match_type": {
      "type": "string",
      "default": "mutual",
      "description": "Match origin. New matches use mutual or team; legacy origins remain readable without granting privileges."
    }
  },
  "required": [
    "user1_id",
    "user2_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user1_id": "{{user.id}}"
        },
        {
          "data.user2_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user1_id": "{{user.id}}"
        },
        {
          "data.user2_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user1_id": "{{user.id}}"
        },
        {
          "data.user2_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user1_id": "{{user.id}}"
        },
        {
          "data.user2_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
