{
  "name": "GroupMessage",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "ID of the group (user ID of the group creator / owner)"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "sender_photo": {
      "type": "string",
      "description": "Profile photo URL of the sender"
    },
    "content": {
      "type": "string",
      "description": "Message text"
    }
  },
  "required": [
    "group_id",
    "sender_id",
    "content"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.sender_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.group_id": "{{user.id}}"
        },
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.sender_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.sender_id": "{{user.id}}"
        }
      ]
    }
  }
}