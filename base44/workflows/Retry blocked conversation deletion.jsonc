{
  "name": "Retry blocked conversation deletion",
  "description": "Retry incomplete deletion of blocked private conversations once per hour. Runs as the workflow creator, who must be an app administrator.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-09-26T00:00:00",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "retry_blocked_conversation_deletion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cleanupUserBlocks",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}