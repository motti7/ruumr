{
  "name": "Delete expired Facebook rooms",
  "description": "Delete imported Facebook room listings 21 days after their original publication. Runs once daily as the administrator who created the workflow. Native user listings are excluded.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": 24,
      "interval_unit": "hours",
      "interval_anchor": "2026-10-22T00:00:00",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "delete_expired_facebook_rooms",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cleanupExpiredRoomListings",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}